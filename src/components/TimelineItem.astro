---
interface Props {
  title: string;
  subtitle: string;
  date: string;
  isRightAligned?: boolean;
  url?: string;
}

const { title, subtitle, date, isRightAligned = false, url } = Astro.props;
---

<div class="grid grid-cols-[1fr_max-content_1fr] gap-x-6">
    <!-- Columna Izquierda -->
    { !isRightAligned && (
      <div>
        <h3 class="text-base font-medium">
          {url ? (
            <a href={url} target="_blank" rel="noopener noreferrer" class="hover:text-green transition-colors">
              {title}
              <i class="ri-external-link-line ml-1 text-xs"></i>
            </a>
          ) : (
            title
          )}
        </h3>
        <span class="text-sm text-lightgray inline-block mb-2">{subtitle}</span>
        <div class="text-xs text-lightgray">
          <i class="ri-calendar-line"></i>
          {date}
        </div>
      </div>

      <div>
        <span class="absolute flex items-center justify-center w-3 h-3 bg-white-100 rounded-full  ring-4 ring-white dark:ring-white/20 dark:bg-green"></span>
        <span class="block w-[2px] h-full bg-gray-200 dark:bg-white/20 translate-x-[5px] translate-y-[1px] transform"></span>
      </div>
    )}

  <!-- Columna Derecha -->
    { isRightAligned && (
      <div></div>
      <div>
        <span class="absolute flex items-center justify-center w-3 h-3 bg-white-100 rounded-full  ring-4 ring-white dark:ring-white/20 dark:bg-green"></span>
        <span class="block w-[2px] h-full bg-gray-200 dark:bg-white/20 translate-x-[5px] translate-y-[1px] transform"></span>
      </div>
      <div>
        <h3 class="text-base font-medium">
          {url ? (
            <a href={url} target="_blank" rel="noopener noreferrer" class="hover:text-green transition-colors">
              {title}
              <i class="ri-external-link-line ml-1 text-xs"></i>
            </a>
          ) : (
            title
          )}
        </h3>
        <span class="text-sm text-lightgray inline-block mb-2">{subtitle}</span>
        <div class="text-xs text-lightgray">
          <i class="ri-calendar-line"></i>
          {date}
        </div>
      </div>
    )}
</div>