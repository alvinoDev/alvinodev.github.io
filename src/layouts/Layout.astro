---
import '@fontsource-variable/onest';

import "../styles/global.css";

import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/webp" href="/icon.webp" />
		<link href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css" rel="stylesheet" />

		<meta name="generator" content={Astro.generator} />
		<title>alvinoDev</title>
	</head>
	<body class="relative min-h-screen bg-black">
    
		<div class="absolute inset-0 -z-3">
			<div class="absolute inset-0 bg-[linear-gradient(to_right,#2f2f2f21_1px,transparent_1px),linear-gradient(to_bottom,#2f2f2f21_1px,transparent_1px)] bg-size[32px_32px] mask-[radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"></div>
		</div>

		<div class="absolute inset-0 -z-4" style="background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(34, 197, 94, 0.25), transparent 70%), #000000"/>
		
		<Header />
		<slot />
		<Footer />
	
	</body>
	
</html>

<style is:global>
	:root {
		color-scheme: light dark;
	}

	html {
		font-family: 'Onest Variable', sans-serif;
	}
</style>